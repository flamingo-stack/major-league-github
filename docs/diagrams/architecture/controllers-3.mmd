flowchart TD
    Request["Search Request"] --> CacheReady{"Cache Ready?"}
    CacheReady -->|"No"| Error["Return ApiResponse.error"]
    CacheReady -->|"Yes"| CacheLookup["Cache Service getHttpResponse()"]

